{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "netcup": {
      "name": "netcup LLM Inference",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://llm-gateway.netcup.net/v1" },
      "models": {
        "DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 393216 },
          "settings": { "reasoningEffort": "high" },
          "variants": [
            { "id": "off", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "Qwen3.8-27B-FP8": {
          "name": "Qwen3.8 27B FP8",
          "capabilities": { "tools": true, "input": ["text", "image", "video"], "output": ["text"] },
          "limit": { "context": 262144, "output": 131072 },
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "off", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B A3B",
          "capabilities": { "tools": true, "input": ["text", "image", "video"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
          "settings": { "reasoningEffort": "high" },
          "variants": [
            { "id": "off", "settings": { "reasoningEffort": "none" } }
          ]
        },
        "gemma-4-26B-A4B": {
          "name": "Gemma 4 26B A4B",
          "capabilities": { "tools": true, "input": ["text", "image", "video"], "output": ["text"] },
          "limit": { "context": 262144, "output": 16384 },
          "variants": [
            { "id": "on", "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    }
  },
  "plugins": [
    "@slkiser/opencode-quota"
  ]
}
